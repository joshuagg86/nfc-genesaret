rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function uid() { return request.auth.uid; }
  function profile() { return get(/databases/$(database)/documents/usuarios/$(uid())).data; }
  function role(roles) { return signed() && profile().get('activo', false) == true && profile().role in roles; }
  function admin() { return role(['admin','administrador']); }
  function seller() { return role(['vendedor']); }
  function cash() { return admin() || seller(); }
  function kiosk() { return role(['autoservicio']); }
  function kitchen() { return role(['cocina']); }
  function display() { return role(['tv']); }
  function staff() { return role(['admin','administrador','vendedor','autoservicio','cocina','tv']); }
  function activeEvent(id) { return get(/databases/$(database)/documents/eventos/$(id)).data.activo == true; }
  function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
  function station(id) { return get(/databases/$(database)/documents/estaciones_venta/$(id)).data; }
  function validStation(d) { return station(d.estacionId).activo == true && station(d.estacionId).vendedorId == d.vendedorId && station(d.estacionId).eventId == d.eventId; }
  // Experimental integrity rules: bounded simple-product checkout, no recipes.
  function salePath(id) { return /databases/$(database)/documents/ventas_integridad/$(id); }
  function linePath(id) { return /databases/$(database)/documents/transacciones/$(id); }
  function productPath(id) { return /databases/$(database)/documents/articulos/$(id); }
  function walletPath(id) { return /databases/$(database)/documents/pulseras/$(id); }
  function newSale(id) { return id is string && !exists(salePath(id)) && existsAfter(salePath(id)) && getAfter(salePath(id)).data.vendedorId==uid(); }
  function closeMoney(a,b) { return a>=b-0.000001 && a<=b+0.000001; }
  function supplyPath(id) { return /databases/$(database)/documents/insumos/$(id); }
  function movementPath(id) { return /databases/$(database)/documents/movimientos_insumos/$(id); }
  function expectedUsage(r,l) {
    let sel=l.seleccionIntegridad;
    return (r.lines.size()>0 && !(r.lines[0].id in sel.removed) ? [{'id':r.lines[0].id,'amount':r.lines[0].amount*l.cantidad}] : []).concat((r.lines.size()>1 && !(r.lines[1].id in sel.removed) ? [{'id':r.lines[1].id,'amount':r.lines[1].amount*l.cantidad}] : []).concat((r.extras.size()>0 && r.extras[0].id in sel.extra ? [{'id':r.extras[0].id,'amount':r.extras[0].amount*l.cantidad}] : []).concat((r.extras.size()>1 && r.extras[1].id in sel.extra ? [{'id':r.extras[1].id,'amount':r.extras[1].amount*l.cantidad}] : [])))); 
  }
  function usedAmount(r,l,i) {
    let sel=l.seleccionIntegridad;
    return (r.lines.size()>0 && r.lines[0].id==i && !(i in sel.removed) ? r.lines[0].amount*l.cantidad : 0) + (r.lines.size()>1 && r.lines[1].id==i && !(i in sel.removed) ? r.lines[1].amount*l.cantidad : 0) + (r.extras.size()>0 && r.extras[0].id==i && i in sel.extra ? r.extras[0].amount*l.cantidad : 0) + (r.extras.size()>1 && r.extras[1].id==i && i in sel.extra ? r.extras[1].amount*l.cantidad : 0);
  }
  function supplyDelta(i,l,r,id) {
    let n=usedAmount(r,l,i);
    let p=get(supplyPath(i)).data;
    let q=getAfter(supplyPath(i)).data;
    return n is int && n>0 && p.eventId==l.eventId && q.stock==p.stock-n && q.stock>=0 && q.ultimaVentaId==id;
  }
  function recipeValid(p,l,id,s) {
    let r=p.recetaActiva;
    let sel=l.seleccionIntegridad;
    let usage=expectedUsage(r,l);
    let removable=(r.lines.size()>0 && r.lines[0].removable==true ? [r.lines[0].id] : []).concat((r.lines.size()>1 && r.lines[1].removable==true ? [r.lines[1].id] : []));
    let extras=(r.extras.size()>0 ? [r.extras[0].id] : []).concat((r.extras.size()>1 ? [r.extras[1].id] : []));
    let extraPrice=(r.extras.size()>0 && r.extras[0].id in sel.extra ? r.extras[0].price : 0) + (r.extras.size()>1 && r.extras[1].id in sel.extra ? r.extras[1].price : 0);
    return p.get('produccionPorLotes',false)==false && r.lines.size()<=2 && r.extras.size()<=2 &&
      sel.removed is list && sel.extra is list && sel.removed.size()<=2 && sel.extra.size()<=2 &&
      sel.removed.toSet().size()==sel.removed.size() && sel.extra.toSet().size()==sel.extra.size() &&
      removable.hasAll(sel.removed) && extras.hasAll(sel.extra) && !sel.removed.hasAny(sel.extra) &&
      l.descuentoInsumos==usage && closeMoney(l.precioUnitario,p.precio+extraPrice) &&
      closeMoney(l.monto,l.precioUnitario*l.cantidad) &&
      (usage.size()<=0 || supplyDelta(usage[0].id,l,r,id)) &&
      (usage.size()<=1 || usage[1].id==usage[0].id || supplyDelta(usage[1].id,l,r,id)) &&
      (usage.size()<=2 || usage[2].id==usage[0].id || usage[2].id==usage[1].id || supplyDelta(usage[2].id,l,r,id)) &&
      (usage.size()<=3 || usage[3].id==usage[0].id || usage[3].id==usage[1].id || usage[3].id==usage[2].id || supplyDelta(usage[3].id,l,r,id));
  }
  function linkedSupply(i) {
    let id=request.resource.data.ultimaVentaId;
    let l=getAfter(linePath(id+'_0')).data;
    let p=get(productPath(l.articuloId)).data;
    let n=usedAmount(p.recetaActiva,l,i);
    let m=getAfter(movementPath(id+'_'+i)).data;
    return newSale(id) && n is int && n>0 &&
      request.resource.data.stock==resource.data.stock-n && request.resource.data.stock>=0 &&
      m.carritoId==id && m.insumoId==i && m.usuarioId==uid() && m.eventId==resource.data.eventId && m.delta==-n && m.stockFinal==request.resource.data.stock && m.motivo=='Venta';
  }
  function linkedMovement(id) {
    let m=request.resource.data;
    let p=get(supplyPath(m.insumoId)).data;
    let q=getAfter(supplyPath(m.insumoId)).data;
    return id==m.carritoId+'_'+m.insumoId && newSale(m.carritoId) && q.ultimaVentaId==m.carritoId &&
      m.usuarioId==uid() && m.eventId==p.eventId && m.motivo=='Venta' && m.delta is int && m.delta<0 &&
      m.delta==q.stock-p.stock && m.stockFinal==q.stock;
  }
  function validLine(s,id,lid) {
    let l=getAfter(linePath(lid)).data;
    let p=get(productPath(l.articuloId)).data;
    return !exists(linePath(lid)) && l.carritoId==id && l.lineasVenta==s.lineas && l.vendedorId==uid() && l.eventId==s.eventId && l.metodoPago==s.metodoPago && l.estadoPago==s.estadoPago && l.pulseraId==s.pulseraId && l.cantidad is int && l.cantidad>0 && l.cantidad<=100 && p.eventId==s.eventId && (p.get('recetaActiva',null)==null ? (closeMoney(l.precioUnitario,p.precio) && closeMoney(l.monto,p.precio*l.cantidad) && l.descuentoInsumos.size()==0) : (lid==id+'_0' && recipeValid(p,l,id,s))) && l.monto>0 && (p.get('esInfinito',false)==true ? l.descuentoProducto==0 : (l.descuentoProducto==l.cantidad && getAfter(productPath(l.articuloId)).data.stock==p.stock-l.cantidad && getAfter(productPath(l.articuloId)).data.ultimaVentaId==id));
  }
  function lineAmount(lid) { return getAfter(linePath(lid)).data.monto; }
  function distinctProducts(a,b) { return getAfter(linePath(a)).data.articuloId!=getAfter(linePath(b)).data.articuloId; }
  function freshLine(lid) { return !exists(linePath(lid)) && existsAfter(linePath(lid)); }
  function validLines(s,id) {
    let a=id+'_0'; let b=id+'_1'; let c=id+'_2'; let d=id+'_3';
    return s.lineas>=1 && s.lineas<=4 && freshLine(a) &&
      (s.lineas<2 || (freshLine(b) && distinctProducts(a,b))) &&
      (s.lineas<3 || (freshLine(c) && distinctProducts(a,c) && distinctProducts(b,c))) &&
      (s.lineas<4 || (freshLine(d) && distinctProducts(a,d) && distinctProducts(b,d) && distinctProducts(c,d))) &&
      closeMoney(s.total,lineAmount(a)+(s.lineas>=2?lineAmount(b):0)+(s.lineas>=3?lineAmount(c):0)+(s.lineas>=4?lineAmount(d):0));
  }
  function validSellerLine(id) {
    let l=request.resource.data;
    let sid=l.carritoId;
    let s=getAfter(salePath(sid)).data;
    return newSale(sid) && (id==sid+'_0' || (s.lineas>=2 && id==sid+'_1') || (s.lineas>=3 && id==sid+'_2') || (s.lineas>=4 && id==sid+'_3')) && validLine(s,sid,id);
  }
  function validWallet(s,id) {
    return s.metodoPago!='nfc' || (s.estadoPago=='pagado' && s.pulseraId is string && get(walletPath(s.pulseraId)).data.get('bloqueada',false)==false && get(walletPath(s.pulseraId)).data.get('activo',true)==true && closeMoney(getAfter(walletPath(s.pulseraId)).data.saldoActual,get(walletPath(s.pulseraId)).data.saldoActual-s.total) && getAfter(walletPath(s.pulseraId)).data.ultimaVentaId==id);
  }
  function linkedProduct(id) {
    let sid=request.resource.data.ultimaVentaId;
    let s=getAfter(salePath(sid)).data;
    return resource.data.get('esInfinito',false)==false && newSale(sid) && ((getAfter(linePath(sid+'_0')).data.articuloId==id) || (s.lineas>=2 && getAfter(linePath(sid+'_1')).data.articuloId==id) || (s.lineas>=3 && getAfter(linePath(sid+'_2')).data.articuloId==id) || (s.lineas>=4 && getAfter(linePath(sid+'_3')).data.articuloId==id));
  }
  function linkedConfirmation(eventId,sellerId) {
    let d=request.resource.data;
    let s=getAfter(salePath(d.carritoId)).data;
    return newSale(d.carritoId) && s.eventId==eventId && s.vendedorId==sellerId && s.estadoPago=='pagado' && closeMoney(d.total,s.total);
  }
  match /ventas_integridad/{id} {
    allow get: if admin() || (seller() && (resource==null || resource.data.vendedorId==uid()));
    allow create: if seller() && request.resource.data.keys().hasOnly(['vendedorId','eventId','metodoPago','estadoPago','pulseraId','lineas','total']) && request.resource.data.vendedorId==uid() && activeEvent(request.resource.data.eventId) && request.resource.data.lineas is int && request.resource.data.total is number && request.resource.data.total>0 && request.resource.data.metodoPago in ['efectivo','transferencia','nfc'] && request.resource.data.estadoPago in ['pagado','pendiente'] && validLines(request.resource.data,id) && validWallet(request.resource.data,id);
  }
  match /usuarios/{id} {
   allow get: if signed() && (uid()==id || admin());
   allow list, create, update, delete: if admin();
  }
  match /eventos/{id} {
   allow read: if staff();
   allow write: if admin();
   match /pedidos_cocina/{order} {
    allow get: if admin() || kitchen() || display() || (seller() && (resource==null || resource.data.vendedorId==uid()));
    allow list: if admin() || kitchen() || display();
    allow create: if cash() && activeEvent(id) && request.resource.data.keys().hasOnly(['items','numeroPedido','fecha','estado','vendedorId','pagoPendiente']) && request.resource.data.vendedorId==uid() && request.resource.data.fecha==request.time && request.resource.data.estado=='activo' && request.resource.data.items is list && request.resource.data.items.size()>0 && request.resource.data.items.size()<=100 && request.resource.data.numeroPedido is int && request.resource.data.pagoPendiente is bool;
    allow update: if admin() && changed(['estado','pagoPendiente']) || (seller() && resource.data.vendedorId==uid() && changed(['pagoPendiente']) && request.resource.data.pagoPendiente==false);
   }
   match /confirmaciones_caja/{sellerId} {
    allow get: if admin() || kiosk() || (seller() && sellerId==uid());
    allow create, update: if cash() && (admin() || linkedConfirmation(id,sellerId)) && sellerId==uid() && activeEvent(id) && request.resource.data.keys().hasOnly(['carritoId','total','kitchen','numeroPedido','fecha','vendedorId']) && request.resource.data.vendedorId==uid() && request.resource.data.fecha==request.time && request.resource.data.total is number && request.resource.data.total>0 && request.resource.data.kitchen is bool && request.resource.data.numeroPedido is int;
   }
   match /contadores/{counter} {
    allow get: if cash();
    allow create: if cash() && activeEvent(id) && counter=='pedidos' && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo==1;
    allow update: if cash() && activeEvent(id) && counter=='pedidos' && changed(['ultimo']) && request.resource.data.ultimo==resource.data.ultimo+1;
    allow delete: if admin();
   }
   match /preparacion_pedidos/{order} {
    allow read: if admin() || kitchen() || display();
    allow create: if (admin() || kitchen()) && activeEvent(id) && request.resource.data.keys().hasOnly(['estado','updatedAt','updatedBy']) && request.resource.data.estado=='preparando' && request.resource.data.updatedBy==uid() && request.resource.data.updatedAt==request.time;
    allow update: if (admin() || kitchen()) && activeEvent(id) && changed(['estado','updatedAt','updatedBy']) && request.resource.data.updatedBy==uid() && request.resource.data.updatedAt==request.time && ((resource.data.estado=='pendiente' && request.resource.data.estado=='preparando') || (resource.data.estado=='preparando' && request.resource.data.estado=='listo') || (resource.data.estado=='listo' && request.resource.data.estado=='entregado'));
   }
  }
  match /articulos/{id} {
   allow read: if cash() || kiosk();
   allow create, delete: if admin();
   allow update: if admin() || (seller() && activeEvent(resource.data.eventId) && changed(['stock','ultimaVentaId']) && linkedProduct(id) && request.resource.data.stock is number && request.resource.data.stock>=0 && request.resource.data.stock<=resource.data.stock);
  }
  match /insumos/{id} {
   allow get: if cash() || kiosk();
   allow list, create, delete: if admin();
   allow update: if admin() || (seller() && changed(['stock','ultimaVentaId']) && linkedSupply(id));
  }
  match /categorias/{id} { allow read: if cash() || kiosk(); allow write: if admin(); }
  match /recetas_borrador/{id} { allow read, write: if admin(); }
  match /lotes_produccion/{id} { allow read, write: if admin(); }
  match /bitacora_stock/{id} { allow read, write: if admin(); }
  match /movimientos_insumos/{id} {
   allow read, update, delete: if admin();
   allow create: if admin() || (seller() && linkedMovement(id));
  }
  match /pulseras/{id} {
   allow read: if cash();
   allow create, delete: if admin();
   allow update: if admin() || (seller() && changed(['saldoActual','ultimaVentaId']) && newSale(request.resource.data.ultimaVentaId) && getAfter(salePath(request.resource.data.ultimaVentaId)).data.pulseraId==id && getAfter(salePath(request.resource.data.ultimaVentaId)).data.metodoPago=='nfc' && resource.data.get('bloqueada',false)==false && resource.data.get('activo',true)==true && request.resource.data.saldoActual is number && request.resource.data.saldoActual>=0 && request.resource.data.saldoActual<=resource.data.saldoActual);
  }
  match /recargas/{id} { allow read, write: if admin(); }
  match /transacciones/{id} {
   allow get: if admin() || (seller() && (resource==null || resource.data.vendedorId==uid()));
   allow list: if admin() || (seller() && resource.data.vendedorId==uid());
   allow create: if (seller() && validSellerLine(id)) || (admin() && request.resource.data.vendedorId==uid() && activeEvent(request.resource.data.eventId) && request.resource.data.cantidad is int && request.resource.data.cantidad>0 && request.resource.data.precioUnitario is number && request.resource.data.precioUnitario>0 && closeMoney(request.resource.data.monto,request.resource.data.precioUnitario*request.resource.data.cantidad) && request.resource.data.estadoPago in ['pagado','pendiente'] && request.resource.data.metodoPago in ['nfc','efectivo','transferencia'] && !(request.resource.data.estadoPago=='pendiente' && request.resource.data.metodoPago=='nfc'));
   allow update: if admin() || (seller() && resource.data.vendedorId==uid() && resource.data.estadoPago=='pendiente' && request.resource.data.estadoPago=='pagado' && changed(['estadoPago','fechaVenta','fecha','fechaPago','turnoCajaId']));
   allow delete: if false;
  }
  match /anulaciones/{id} { allow read, create: if admin(); }
  match /estaciones_venta/{id} {
   allow get: if cash() || kiosk();
   allow list: if admin() || (seller() && resource.data.vendedorId==uid());
   allow write: if admin();
  }
  match /estaciones_asignaciones/{id} { allow read, write: if admin(); }
  match /estaciones_codigos/{id} { allow get: if admin() || kiosk(); allow list, write: if admin(); }
  match /pedidos_autoservicio/{id} {
   allow get: if admin() || (seller() && resource.data.vendedorId==uid()) || (kiosk() && (resource==null || resource.data.creadoPor==uid()));
   allow list: if admin() || (seller() && resource.data.vendedorId==uid());
   allow create: if (kiosk() || admin()) && request.resource.data.keys().hasOnly(['eventId','items','total','estado','estacionId','vendedorId','creadoPor','fecha']) && request.resource.data.creadoPor==uid() && request.resource.data.estado=='pendiente' && request.resource.data.fecha==request.time && request.resource.data.items is list && request.resource.data.items.size()>0 && request.resource.data.items.size()<=100 && request.resource.data.total is number && request.resource.data.total>0 && validStation(request.resource.data) && activeEvent(request.resource.data.eventId);
   allow update: if (admin() || seller()) && resource.data.vendedorId==uid() && resource.data.estado=='pendiente' && validStation(resource.data) && ((request.resource.data.estado=='cobrado' && request.resource.data.cobradoPor==uid() && changed(['estado','carritoId','numeroPedido','cobradoPor','cobradoAt','itemsFinales','totalFinal','modificadoEnCaja'])) || (request.resource.data.estado=='cancelado' && request.resource.data.canceladoPor==uid() && changed(['estado','canceladoPor','canceladoAt'])));
  }
  match /estaciones_presencia/{id} {
   allow read: if admin();
   allow create, update: if (cash() || kiosk()) && request.resource.data.keys().hasOnly(['stationId','role','uid','code','lastSeen']) && request.resource.data.uid==uid() && request.resource.data.lastSeen==request.time && (resource==null || resource.data.uid==uid()) && station(request.resource.data.stationId).activo==true && ((request.resource.data.role=='caja' && cash() && station(request.resource.data.stationId).vendedorId==uid()) || (request.resource.data.role=='autoservicio' && (kiosk() || admin()) && request.resource.data.code==station(request.resource.data.stationId).get('codigoVinculacion',request.resource.data.stationId)));
   allow delete: if admin() || (staff() && resource.data.uid==uid());
  }
  match /cajas_activas/{id} {
   allow get: if admin() || (seller() && uid()==id);
   allow list: if admin();
   allow create, update: if cash() && uid()==id && request.resource.data.keys().hasOnly(['turnoId','ultimoTurnoId']);
  }
  match /turnos_caja/{id} {
   allow get, list: if admin() || (seller() && resource.data.vendedorId==uid());
   allow create: if cash() && request.resource.data.vendedorId==uid() && request.resource.data.estado=='abierto' && request.resource.data.fondoInicial is int && request.resource.data.fondoInicial>=0 && request.resource.data.efectivoVentas==0 && request.resource.data.entradas==0 && request.resource.data.salidas==0 && request.resource.data.abiertoAt==request.time;
   allow update: if cash() && (admin() || resource.data.vendedorId==uid()) && resource.data.estado=='abierto' && ((request.resource.data.estado=='abierto' && changed(['efectivoVentas','entradas','salidas'])) || (request.resource.data.estado=='cerrado' && changed(['estado','efectivoEsperado','efectivoContado','diferencia','cerradoAt']) && request.resource.data.cerradoAt==request.time && request.resource.data.efectivoEsperado==resource.data.fondoInicial+resource.data.efectivoVentas+resource.data.entradas-resource.data.salidas && request.resource.data.efectivoContado is int && request.resource.data.efectivoContado>=0 && request.resource.data.diferencia==request.resource.data.efectivoContado-request.resource.data.efectivoEsperado));
   match /movimientos/{movement} {
    allow read: if admin() || (seller() && get(/databases/$(database)/documents/turnos_caja/$(id)).data.vendedorId==uid());
    allow create: if cash() && get(/databases/$(database)/documents/turnos_caja/$(id)).data.vendedorId==uid() && get(/databases/$(database)/documents/turnos_caja/$(id)).data.estado=='abierto' && request.resource.data.usuarioId==uid() && request.resource.data.tipo in ['entradas','salidas'] && request.resource.data.importe is int && request.resource.data.importe>0 && request.resource.data.fecha==request.time;
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
